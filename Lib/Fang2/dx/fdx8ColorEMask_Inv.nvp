; PC port: fog is read from blue - ps.1.1 texcoord gives alpha 1; see fdx8sh.cpp fsh_Fog_Enable
;
; Pixel shader 

; Declare pixel shader version 1.1
ps.1.1

tex t0			; Mask
texcoord t2		; fog (PC port: emissive now comes in c7, see fdx8sh.cpp)

mov r0.a, 1-t0.a
mad r0.rgb, c7, r0.a, v0      ; Emissive*t0.a + Diffuse
mov r0.a, t2.b

